# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit a real key.

# --- The model ---------------------------------------------------------------
# Gemini, used for every turn. Get a key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Document search (the search_documents tool) -----------------------------
# Cloudflare Workers AI does the embedding; Cloudflare Vectorize stores and
# searches the index. Both live under the same account.
#
# CF_ACCOUNT_ID       Cloudflare dashboard -> right-hand sidebar -> Account ID
# CF_API_TOKEN        My Profile -> API Tokens -> Create Token, with the
#                     "Workers AI" and "Vectorize" permissions (Edit)
# CF_VECTORIZE_INDEX  the name you gave the index when you created it
#
# Leave these blank and the app still runs: every other tool works, and
# search_documents reports that it is not configured rather than crashing.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_VECTORIZE_INDEX=
